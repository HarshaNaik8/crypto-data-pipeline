# .dockerignore
# Ignore virtual environments
venv/
.venv/
env/

# Python bytecode and caches
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Git metadata
.git/
.gitignore

# Local secrets & sensitive files (pass via docker-compose env_file or -e flags)
.env

# Local data & logs (mounted via volumes if needed)
data/
logs/
*.db
*.sqlite
*.sqlite3

# Large binary files
*.pbix

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
