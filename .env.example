# CoinGecko API Configuration
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
SYMBOLS=bitcoin,ethereum,solana

# Database Connection
DB_CONNECTION_STRING=sqlite:///crypto_pipeline.db

# Logging Level
LOG_LEVEL=INFO

# Data Observability & Alerting (Discord Webhook URL — one-way alerts)
# Leave blank to disable alerts, or paste your Discord webhook URL here:
DISCORD_WEBHOOK_URL=

# Discord Bot Token (two-way interactive commands)
# Get yours from: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=